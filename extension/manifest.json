{
  "manifest_version": 3,
  "name": "YouTube Obsync",
  "description": "Capture YouTube moments as connected Obsidian notes.",
  "version": "0.1.1",
  "action": {
    "default_title": "YouTube Obsync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": [
    "<all_urls>",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "http://localhost:4177/*",
    "http://127.0.0.1:4177/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://127.0.0.1:*/*",
    "https://localhost:*/*"
  ]
}
